	<property name="ireport.zoom" value="1.9487171000000083"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="ID_ESTILO" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select sp.nombre as parametro, 
sa1.nombre as ali_1,
sa2.nombre as ali_2,
sa3.nombre as ali_3,
sa4.nombre as ali_4
from seleccion s
join tejido_circulares tc on s.id_tejido_circulares = tc.id_tejido_circulares
left join seleccion_alimentador sa1 on s.id_seleccion_alimentador_1 = sa1.id_seleccion_alimentador
left join seleccion_alimentador sa2 on s.id_seleccion_alimentador_2 = sa2.id_seleccion_alimentador
left join seleccion_alimentador sa3 on s.id_seleccion_alimentador_3 = sa3.id_seleccion_alimentador
left join seleccion_alimentador sa4 on s.id_seleccion_alimentador_4 = sa4.id_seleccion_alimentador
left join seleccion_parametro sp on s.id_seleccion_parametro = sp.id_seleccion_parametro
where tc.id_estilo = $P{ID_ESTILO}
order by s.id_seleccion]]>
	</queryString>
	<field name="parametro" class="java.lang.String"/>
	<field name="ali_1" class="java.lang.String"/>
	<field name="ali_2" class="java.lang.String"/>
	<field name="ali_3" class="java.lang.String"/>
	<field name="ali_4" class="java.lang.String"/>
